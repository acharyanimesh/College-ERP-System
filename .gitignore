# Byte-compiled / pycacahe
__pycache__/
*.py[cod]
*$py.class

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
# db.sqlite3 is intentionally committed so the data + admin login sync across devices.
# Backup snapshots are NOT committed:
db.sqlite3.bak*
*.bak

# Environments
.vscode
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# Collected static files (collectstatic output)
/static/

# Uploaded media. Only the .gitkeep is tracked — profile photos and bank
# deposit slips are people's own documents and have no business in a public
# repository, whatever db.sqlite3 says about them.
/media/*
!/media/.gitkeep

